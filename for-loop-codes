//factorial


#include <stdio.h>

int main()
{
    int i, n, fact = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    printf("Factorial = %d", fact);

    return 0;
}

//fibonacci series

#include <stdio.h>

int main()
{
    int a = 0, b = 1, c, i;

    for (i = 1; i <= 10; i++)
    {
        printf("%d ", a);

        c = a + b;
        a = b;
        b = c;
    }

    return 0;
}

//Number digit count

#include <stdio.h>

int main()
{
    int n, count = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    for (; n != 0; n = n / 10)
    {
        count++;
    }

    printf("Number of digits = %d", count);

    return 0;
}
